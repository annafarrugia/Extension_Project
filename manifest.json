{
    "manifest_version": 3,
    "name": "Assignment Tracker Extension",
    "version": "1.0",
    "description": "A Chrome extension to input and track assignments in google sheets tracker",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
     },
     "permissions": [
        "storage",
        "notifications",
        "alarms",
        "identity"
     ],
     "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
     }
     
}

{
    "manifest_version": 3,
    "name": "Assignment Tracker Extension",
    "version": "1.0",
    "description": "A Chrome extension to input and track assignments in google sheets tracker",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
     },
     "permissions": [
        "storage",
        "notifications",
        "alarms",
        "identity"
     ],
     "oauth2" : {
        "client_id": "266436359923-mpajiar5c21901qkooh96p81nbe50urc.apps.googleusercontent.com",
        "scopes": [
            "https://www.googleapis.com/auth/spreadsheets"
        ]
     },
     "background": {
         "service_worker": "background.js"
     },
     "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
     }
     
}
